    "https://componentes-fe-cmq0d9kr.cloud.serendiped.com/r/badge.json",
    "https://componentes-fe-cmq0d9kr.cloud.serendiped.com/r/card.json",
    "https://componentes-fe-cmq0d9kr.cloud.serendiped.com/r/compare.json",
    "https://componentes-fe-cmq0d9kr.cloud.serendiped.com/r/direction-aware-hover.json",
    "https://componentes-fe-cmq0d9kr.cloud.serendiped.com/r/draggable-card.json",
    "https://componentes-fe-cmq0d9kr.cloud.serendiped.com/r/file-upload.json",
    "https://componentes-fe-cmq0d9kr.cloud.serendiped.com/r/glowing-stars-effect.json",
